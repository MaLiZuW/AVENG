# TODO(owner): verify the hosting honours .htaccess

# AddValueEngineering: legacy service URLs (301)
RedirectMatch 301 ^/sluzby/fractional-technical-leadership/?$ /sluzby/
RedirectMatch 301 ^/sluzby/zavadzanie-procesov-plm-pdm/?$ /sluzby/sprava-dokumentacie-a-schvalovanie/
RedirectMatch 301 ^/sluzby/riadenie-zmien-eco/?$ /sluzby/projekt-zmeny-eco/

RewriteEngine On

# Retired service URLs (301) to their project-based destinations
RewriteRule ^sluzby/fractional-technical-leadership/?$ https://www.addvalueengineering.sk/sluzby/ [R=301,L]
RewriteRule ^sluzby/zavadzanie-procesov-plm-pdm/?$ https://www.addvalueengineering.sk/sluzby/sprava-dokumentacie-a-schvalovanie/ [R=301,L]
RewriteRule ^sluzby/riadenie-zmien-eco/?$ https://www.addvalueengineering.sk/sluzby/projekt-zmeny-eco/ [R=301,L]

# Legacy WordPress paths (301) to the canonical host
RewriteRule ^zadarmo-pre-vas/?$ https://www.addvalueengineering.sk/self-audit/ [R=301,L]
RewriteRule ^category/category-1/?$ https://www.addvalueengineering.sk/ [R=301,L]

# Force HTTPS and www — matches metadataBase (https://www.addvalueengineering.sk)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.addvalueengineering.sk/$1 [L,R=301]

# Static export 404 (out/404.html)
ErrorDocument 404 /404.html

# Security headers (no CSP — add only after a tested policy)
<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Long cache only for content-hashed Next assets
  SetEnvIf Request_URI "^/_next/static/" hashed_asset
  Header set Cache-Control "public, max-age=31536000, immutable" env=hashed_asset
</IfModule>

DirectoryIndex index.html

# Cache static asset types (hashed bundles live under /_next/static/)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Public Supabase credentials (safe for static export / browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Site
NEXT_PUBLIC_SITE_URL=https://www.addvalueengineering.sk

# Contact inbox (FormSubmit / Web3Forms destination)
NEXT_PUBLIC_CONTACT_INBOX=vladimir@addvalueengineering.sk
# Optional: Web3Forms access key (preferred over FormSubmit)
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional booking calendar URL — shows "Dohodnúť 30-min konzultáciu" when set
# NEXT_PUBLIC_BOOKING_URL=https://calendly.com/...

# Unlock API (Supabase Edge Function verify-promo) — required for L2/L3 codes
# NEXT_PUBLIC_UNLOCK_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/verify-promo
# Admin: issue unlock codes (+ email)
# NEXT_PUBLIC_ISSUE_UNLOCK_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/issue-unlock-code

# Self-Audit PDF e-mail (Supabase Edge Function send-audit-report)
# NEXT_PUBLIC_AUDIT_REPORT_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/send-audit-report

# Social profiles for JSON-LD sameAs (omit if empty)
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
# NEXT_PUBLIC_SOCIAL_FACEBOOK=

# --- Server-only (Edge Function secrets — never in client / NEXT_PUBLIC_*) ---
# AUDIT_PROMO_CODES=comma,separated,codes
# UNLOCK_TOKEN_SECRET=long-random-string
# RESEND_API_KEY=re_...
# AUDIT_REPORT_FROM=AddValueEngineering <noreply@addvalueengineering.sk>
# AUDIT_REPORT_OWNER_EMAIL=vladimir@addvalueengineering.sk
# ADMIN_EMAILS=vladimir@addvalueengineering.sk
# UNLOCK_SIGNING_SECRET=long-random-string
# AUDIT_PROMO_CODES_L2=optional,legacy,codes
# AUDIT_PROMO_CODES_L3=optional,legacy,codes
